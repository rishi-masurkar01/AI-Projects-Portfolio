    "from tensorflow.keras.callbacks import (EarlyStopping, ReduceLROnPlateau,\n",
    "                                         ModelCheckpoint, CSVLogger)\n",
    "\n",
    "# 1. Stop training if no improvement\n",
    "early_stop = EarlyStopping(\n",
    "    monitor              = 'val_accuracy',\n",
    "    patience             = 5,\n",
    "    restore_best_weights = True,\n",
    "    verbose              = 1\n",
    ")\n",
    "\n",
    "# 2. Reduce learning rate when stuck\n",
    "reduce_lr = ReduceLROnPlateau(\n",
    "    monitor  = 'val_loss',\n",
    "    factor   = 0.5,\n",
    "    patience = 3,\n",
    "    min_lr   = 1e-7,\n",
    "    verbose  = 1\n",
    ")\n",
    "\n",
    "# 3. Save best model automatically\n",
    "checkpoint = ModelCheckpoint(\n",
    "    filepath          = os.path.join(OUTPUT_DIR, 'baseline_best.h5'),\n",
    "    monitor           = 'val_accuracy',\n",
    "    save_best_only    = True,\n",
    "    save_weights_only = False,\n",
    "    verbose           = 1\n",
    ")\n",
    "\n",
    "# 4. Log training history to CSV\n",
    "csv_logger = CSVLogger(\n",
    "    os.path.join(OUTPUT_DIR, 'baseline_training_log.csv')\n",
    ")\n",
    "\n",
    "callbacks = [early_stop, reduce_lr, checkpoint, csv_logger]\n",
    "\n",
    "print(\"Callbacks ready ✓\")\n",
    "print()\n",
    "print(\"  EarlyStopping    → stops if val_accuracy doesn't improve for 5 epochs\")\n",
    "print(\"  ReduceLROnPlateau→ halves learning rate if val_loss stalls for 3 epochs\")\n",
    "print(\"  ModelCheckpoint  → saves best model automatically\")\n",
    "print(\"  CSVLogger        → logs every epoch to CSV for analysis\")"
