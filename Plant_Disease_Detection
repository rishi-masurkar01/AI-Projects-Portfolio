    "import shutil\n",
    "\n",
    "# ImageDataGenerator needs this flat structure:\n",
    "# working/train/Apple - Apple Scab/img1.jpg\n",
    "# working/train/Apple - Black Rot/img1.jpg\n",
    "# working/val/Apple - Apple Scab/img1.jpg\n",
    "# etc.\n",
    "\n",
    "TRAIN_DIR = os.path.join(OUTPUT_DIR, 'train')\n",
    "VAL_DIR   = os.path.join(OUTPUT_DIR, 'val')\n",
    "TEST_DIR  = os.path.join(OUTPUT_DIR, 'test')\n",
    "\n",
    "def build_flat_structure(force_rebuild=False):\n",
    "\n",
    "    # Check if already built\n",
    "    if os.path.exists(TRAIN_DIR) and not force_rebuild:\n",
    "        existing = len(os.listdir(TRAIN_DIR))\n",
    "        if existing == num_classes:\n",
    "            print(f\"Flat structure already exists ({existing} classes) ✓\")\n",
    "            return\n",
    "\n",
    "    print(\"Building flat directory structure...\")\n",
    "    print(\"This creates symbolic links — no image copying, very fast!\\n\")\n",
    "\n",
    "    for split_name, split_folder in [('Train', TRAIN_DIR),\n",
    "                                      ('Val',   VAL_DIR),\n",
    "                                      ('Test',  TEST_DIR)]:\n",
    "        os.makedirs(split_folder, exist_ok=True)\n",
    "\n",
    "        for plant in plants:\n",
    "            plant_split = os.path.join(DATASET_DIR, plant, split_name)\n",
    "            if not os.path.exists(plant_split):\n",
    "                continue\n",
    "\n",
    "            for disease in sorted(os.listdir(plant_split)):\n",
    "                if disease.startswith('.'):\n",
    "                    continue\n",
    "\n",
    "                src = os.path.join(plant_split, disease)\n",
    "                # Class folder name = \"Plant - Disease\"\n",
    "                dst = os.path.join(split_folder, f\"{plant} - {disease}\")\n",
    "\n",
    "                if not os.path.exists(dst):\n",
    "                    # Use symlink — instant, no disk space used\n",
    "                    os.symlink(src, dst)\n",
    "\n",
    "        classes_built = len(os.listdir(split_folder))\n",
    "        print(f\"  {split_name:<6} → {split_folder}  ({classes_built} classes)\")\n",
    "\n",
    "    print(\"\\nFlat structure ready ✓\")\n",
    "\n",
    "build_flat_structure()"
   ]
