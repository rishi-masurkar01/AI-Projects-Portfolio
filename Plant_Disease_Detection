    "class_names  = []\n",
    "class_counts = {\"train\": {}, \"val\": {}, \"test\": {}}\n",
    "\n",
    "for plant in plants:\n",
    "    train_path = os.path.join(DATASET_DIR, plant, 'Train')\n",
    "    if not os.path.exists(train_path):\n",
    "        continue\n",
    "\n",
    "    for disease in sorted(os.listdir(train_path)):\n",
    "        # Skip hidden files\n",
    "        if disease.startswith('.'):\n",
    "            continue\n",
    "\n",
    "        label = f\"{plant} - {disease}\"\n",
    "        class_names.append(label)\n",
    "\n",
    "        for split in ['Train', 'Val', 'Test']:\n",
    "            split_path = os.path.join(DATASET_DIR, plant, split, disease)\n",
    "            if os.path.exists(split_path):\n",
    "                count = len([\n",
    "                    f for f in os.listdir(split_path)\n",
    "                    if f.lower().endswith(('.jpg', '.jpeg', '.png'))\n",
    "                ])\n",
    "                class_counts[split.lower()][label] = count\n",
    "\n",
    "num_classes = len(class_names)\n",
    "total_train = sum(class_counts['train'].values())\n",
    "total_val   = sum(class_counts['val'].values())\n",
    "total_test  = sum(class_counts['test'].values())\n",
    "total_all   = total_train + total_val + total_test\n",
    "\n",
    "print(f\"Total classes  : {num_classes}\")\n",
    "print(f\"Train images   : {total_train:,}\")\n",
    "print(f\"Val images     : {total_val:,}\")\n",
    "print(f\"Test images    : {total_test:,}\")\n",
    "print(f\"Total images   : {total_all:,}\")\n",
    "print()\n",
    "print(f\"{'#':<4} {'Class':<45} {'Train':>6} {'Val':>5} {'Test':>5}\")\n",
    "print(\"-\" * 68)\n",
    "for i, cls in enumerate(class_names):\n",
    "    tr = class_counts['train'].get(cls, 0)\n",
    "    vl = class_counts['val'].get(cls, 0)\n",
    "    te = class_counts['test'].get(cls, 0)\n",
    "    print(f\"{i+1:<4} {cls:<45} {tr:>6} {vl:>5} {te:>5}\")"
   ]
